# Local-only infrastructure credentials. Replace every value outside local use.
POSTGRES_DB=evidence
POSTGRES_USER=evidence
POSTGRES_PASSWORD=evidence
POSTGRES_PORT=5432
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-local-only
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-only
API_PORT=8000
IMAGE_TAG=local

# Required real providers. research-stack.sh refuses blanks and placeholders.
LLM_API_KEY=replace-with-real-provider-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_SEED=
GILDATA_TOKEN=replace-with-real-gildata-token
ACQUISITION_ENABLED_ADAPTERS=sse,szse,gildata

# Realm-import users are fixed local acceptance identities, never production
# accounts. These values must match infra/keycloak/realm-export.json.
LIVE_KEYCLOAK_USER=alice
LIVE_KEYCLOAK_PASSWORD=alice-local-only-change-me
LIVE_SECOND_KEYCLOAK_USER=bob
LIVE_SECOND_KEYCLOAK_PASSWORD=bob-local-only-change-me
