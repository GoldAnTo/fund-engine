# Copy to an untracked .env.gateway.local, chmod 600, fill SERVER ONLY credentials.
# Choose an URL-safe random DB password (hex is suitable for the DB URL).
GATEWAY_DB_PASSWORD=
# Same opaque token must map to a stable subject in RESEARCH_TENANT_TOKENS.
GATEWAY_PROXY_TOKEN=
RESEARCH_TENANT_TOKENS=
GATEWAY_PUBLIC_PORT=8080
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
GILDATA_TOKEN=
