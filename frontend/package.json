{
  "name": "evidence-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/with-project-node.mjs ./node_modules/vite/bin/vite.js",
    "dev:live": "node scripts/with-project-node.mjs ./node_modules/vite/bin/vite.js",
    "dev:mock": "VITE_RESEARCH_CLIENT=mock node scripts/with-project-node.mjs ./node_modules/vite/bin/vite.js",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/with-project-node.mjs ./node_modules/@playwright/test/cli.js test",
    "verify:live-company-research": "node scripts/with-project-node.mjs scripts/verify-live-company-research-ui.mjs",
    "test:live-company-research-support": "node scripts/with-project-node.mjs --test scripts/live-company-research-support.test.mjs",
    "gen:contract": "openapi-typescript openapi.json -o src/contracts/v1.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "cytoscape": "^3.30.0",
    "dagre": "^0.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/cytoscape": "^3.21.7",
    "@types/dagre": "^0.7.54",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
