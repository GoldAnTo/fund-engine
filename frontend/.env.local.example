# Local development only. Copy to frontend/.env.local; never commit the copy.
# Either use the Vite proxy target below, or set VITE_RESEARCH_API_URL directly.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Public browser OIDC client. Register these exact callback URLs in the IdP.
VITE_OIDC_AUTHORITY=http://127.0.0.1:8080/realms/research
VITE_OIDC_CLIENT_ID=research-web
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
VITE_OIDC_SILENT_REDIRECT_URI=http://127.0.0.1:5173/auth/silent-callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5173
VITE_OIDC_SCOPE=openid profile email
