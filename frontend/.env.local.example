# Local development only. Copy to frontend/.env.local; never commit the copy.
# Either use the Vite proxy target below, or set VITE_RESEARCH_API_URL directly.
VITE_BACKEND_URL=http://127.0.0.1:8000
# This is consumed by the Vite proxy and is never bundled into browser code.
RESEARCH_BEARER_TOKEN=replace-with-a-token-configured-in-RESEARCH_TENANT_TOKENS
